# Copy this file to .env.local. Never commit .env.local or share its private key.
# A Sepolia RPC URL can come from Alchemy, Infura, QuickNode, or another provider.
SEPOLIA_RPC_URL=https://sepolia.example-rpc-url

# Use only a dedicated test wallet with Sepolia ETH. Do not use a wallet holding real funds.
DEPLOYER_PRIVATE_KEY=0xyour_testnet_private_key

# Fill this in after deployment. The frontend will use it in the next step.
NEXT_PUBLIC_LAND_PARCEL_ADDRESS=0xyour_deployed_contract_address
